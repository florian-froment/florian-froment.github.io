---
const projectPages = import.meta.glob("../pages/projects/**/*.astro");
const experiencePages = import.meta.glob("../pages/experience/**/*.astro");
const educationPages = import.meta.glob("../pages/education/**/*.astro");
const aboutPages = import.meta.glob("../pages/about/**/*.astro");

function createMenuItems(
  pages: Record<string, unknown>,
  folder: string
) {
  return Object.keys(pages)
    .filter((path) => !path.endsWith("/index.astro"))
    .map((path) => {
      const relativePath = path
        .split(`/pages/${folder}/`)[1]
        .replace(".astro", "");

      const name = relativePath
        .split("/")
        .pop()!
        .replace(/-/g, " ")
        .replace(/\b\w/g, (letter) => letter.toUpperCase());

      return {
        name,
        href: `/${folder}/${relativePath}`,
      };
    })
    .sort((a, b) => a.name.localeCompare(b.name));
}

const projects = createMenuItems(projectPages, "projects");
const experiences = createMenuItems(experiencePages, "experience");
const education = createMenuItems(educationPages, "education");
const about = createMenuItems(aboutPages, "about");
const completedProjectPages = import.meta.glob(
  "../pages/projects/completed/**/*.astro"
);

const inProgressProjectPages = import.meta.glob(
  "../pages/projects/in-progress/**/*.astro"
);

const visionProjectPages = import.meta.glob(
  "../pages/projects/vision/**/*.astro"
);
const completedProjects = createMenuItems(
  completedProjectPages,
  "projects/completed"
);

const inProgressProjects = createMenuItems(
  inProgressProjectPages,
  "projects/in-progress"
);

const visionProjects = createMenuItems(
  visionProjectPages,
  "projects/vision"
);
---

<header class="site-header">

  <div class="container">

    <nav class="navbar">

      <a href="/" class="logo">

        <img
          src="/images/paraphage-florian-froment.png"
          alt="paraphage-florian-froment"
          class="paraphage-picture"
        />

        <span>Florian Froment</span>

      </a>


      <ul class="nav-links">

        <!-- PROJECTS -->

        <li class="nav-dropdown">

  <a href="/#projects" class="nav-main-link">
    Projects
  </a>

  <div class="dropdown-menu cascading-menu">

    <a href="/#projects" class="dropdown-overview">
      All projects
    </a>

    <div class="dropdown-separator"></div>


    <div class="cascade-item">

      <button class="cascade-trigger">
        <span>Completed</span>
        <span class="cascade-arrow">›</span>
      </button>

      <div class="cascade-submenu">
        {completedProjects.map((page) => (
          <a href={page.href}>
            {page.name}
          </a>
        ))}
      </div>

    </div>


    <div class="cascade-item">

      <button class="cascade-trigger">
        <span>In Progress</span>
        <span class="cascade-arrow">›</span>
      </button>

      <div class="cascade-submenu">
        {inProgressProjects.map((page) => (
          <a href={page.href}>
            {page.name}
          </a>
        ))}
      </div>

    </div>


    <div class="cascade-item">

      <button class="cascade-trigger">
        <span>Vision</span>
        <span class="cascade-arrow">›</span>
      </button>

      <div class="cascade-submenu">
        {visionProjects.map((page) => (
          <a href={page.href}>
            {page.name}
          </a>
        ))}
      </div>

    </div>

  </div>

</li>


        <!-- EXPERIENCE -->

        <li class="nav-dropdown">

          <a href="/#experience" class="nav-main-link">
            Experience
          </a>

          <div class="dropdown-menu">

            <a href="/#experience" class="dropdown-overview">
              All experience
            </a>

            <div class="dropdown-separator"></div>

            {experiences.map((page) => (
              <a href={page.href}>
                {page.name}
              </a>
            ))}

          </div>

        </li>


        <!-- EDUCATION -->

        <li class="nav-dropdown">

          <a href="/#education" class="nav-main-link">
            Education
          </a>

          <div class="dropdown-menu">

            <a href="/#education" class="dropdown-overview">
              All education
            </a>

            <div class="dropdown-separator"></div>

            {education.map((page) => (
              <a href={page.href}>
                {page.name}
              </a>
            ))}

          </div>

        </li>


        <li class="nav-dropdown">

  <a href="/#about" class="nav-main-link">
    About
  </a>

  <div class="dropdown-menu">

    <a href="/#about" class="dropdown-overview">
      About overview
    </a>

    <div class="dropdown-separator"></div>

    {about.map((page) => (
      <a href={page.href}>
        {page.name}
      </a>
    ))}

  </div>

</li>

        <li>
          <a href="/#contact">
            Contact
          </a>
        </li>

      </ul>

    </nav>

  </div>

</header>