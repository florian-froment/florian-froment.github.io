<div class="robot-viewer">

  <model-viewer
  src="/models/K-RockS.glb"
  alt="K-RockS robotic system"

  camera-controls
  disable-pan
  disable-zoom

  auto-rotate
  auto-rotate-delay="3000"
  rotation-per-second="3deg"

  interaction-prompt="none"

  camera-orbit="-35deg 65deg 105%"

    min-camera-orbit="-60deg 35deg 90%"
  max-camera-orbit="60deg 80deg 130%"

  field-of-view="28deg"

  shadow-intensity="0"
  exposure="1"
>
</model-viewer>

</div>

<script
  type="module"
  src="https://ajax.googleapis.com/ajax/libs/model-viewer/4.0.0/model-viewer.min.js">
</script>