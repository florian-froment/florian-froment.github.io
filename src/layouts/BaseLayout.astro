---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import GlobalScripts from "../components/GlobalScripts.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Florian Froment | Portfolio",
  description = "Mechanical Engineering, Robotics & R&D portfolio of Florian Froment."
} = Astro.props;
---

<!doctype html>

<html lang="en">

  <head>

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1"
  />

  <meta
    name="description"
    content={description}
  />

  <link
    rel="icon"
    type="image/svg+xml"
    href="/favicon.svg"
  />

  <link
    rel="alternate icon"
    href="/favicon.ico"
  />

  <title>{title}</title>

</head>

  <body>

    <Header />

    <slot />

<div class="maintenance-watermark">
  PORTFOLIO UNDER DEVELOPMENT
</div>

    <Footer />
    
    <GlobalScripts />

  </body>

</html>
