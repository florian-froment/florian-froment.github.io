---
import ProjectLayout from "../layouts/ProjectLayout.astro";
---

<ProjectLayout
  title="Privacy"
  category="Information | Privacy"
  year="2026"
  description="Privacy information for the personal portfolio of Florian Froment."
>

  <p slot="intro">
    Information about the collection, use and protection of personal data on this website.
  </p>


  <section class="detail-section">

    <div class="detail-index">
      01
    </div>

    <div class="detail-copy">

      <h2>
        Data collection
      </h2>

      <p>
        This website is a personal portfolio and does not currently require
        user accounts, registration or newsletter subscriptions.
      </p>

      <p>
        No personal data is intentionally collected through forms on this website.
      </p>

    </div>

  </section>


  <section class="detail-section">

    <div class="detail-index">
      02
    </div>

    <div class="detail-copy">

      <h2>
        Contact by email
      </h2>

      <p>
        If you contact me by email, the information you provide may include
        your name, email address and any other information contained in your message.
      </p>

      <p>
        This information is used only to respond to your request and is not
        sold, rented or used for advertising purposes.
      </p>

    </div>

  </section>


  <section class="detail-section">

    <div class="detail-index">
      03
    </div>

    <div class="detail-copy">

      <h2>
        Cookies
      </h2>

      <p>
        This website does not currently use advertising or marketing cookies.
      </p>

      <p>
        Essential technical mechanisms may be used when required for the proper
        operation and delivery of the website.
      </p>

      <p>
        If non-essential cookies, analytics tools or tracking technologies are
        introduced in the future, this privacy information will be updated accordingly.
      </p>

    </div>

  </section>


  <section class="detail-section">

    <div class="detail-index">
      04
    </div>

    <div class="detail-copy">

      <h2>
        Hosting
      </h2>

      <p>
        This website is hosted using GitHub Pages.
      </p>

      <p>
        As part of the technical delivery of the website, the hosting provider
        may process technical information such as IP addresses, browser information,
        connection data and server logs.
      </p>

      <p>
        Such processing is managed by the hosting provider under its own privacy
        and security policies.
      </p>

    </div>

  </section>


  <section class="detail-section">

    <div class="detail-index">
      05
    </div>

    <div class="detail-copy">

      <h2>
        External services
      </h2>

      <p>
        This portfolio may contain links to external services such as GitHub,
        LinkedIn, academic institutions or company websites.
      </p>

      <p>
        When you follow an external link, the privacy practices of the destination
        website apply independently from this portfolio.
      </p>

    </div>

  </section>


  <section class="detail-section">

    <div class="detail-index">
      06
    </div>

    <div class="detail-copy">

      <h2>
        Data retention
      </h2>

      <p>
        Personal information received by email is retained only for as long as
        reasonably necessary to respond to the relevant communication or maintain
        appropriate professional correspondence.
      </p>

    </div>

  </section>


  <section class="detail-section">

    <div class="detail-index">
      07
    </div>

    <div class="detail-copy">

      <h2>
        Your rights
      </h2>

      <p>
        You may contact me regarding personal information you have provided,
        including requests relating to access, correction or deletion.
      </p>

      <p>
        Contact:
        <a href="mailto:florian.froment12@gmail.com">
          florian.froment12@gmail.com
        </a>
      </p>

    </div>

  </section>


  <section class="detail-section">

    <div class="detail-index">
      08
    </div>

    <div class="detail-copy">

      <h2>
        Security
      </h2>

      <p>
        Reasonable technical measures are used to maintain the security and integrity
        of this website.
      </p>

      <p>
        However, no internet-based service can guarantee absolute security.
      </p>

    </div>

  </section>


  <section class="detail-section">

    <div class="detail-index">
      09
    </div>

    <div class="detail-copy">

      <h2>
        Changes to this policy
      </h2>

      <p>
        This privacy information may be updated if the website evolves,
        particularly if new forms, analytics tools, embedded services or other
        data-processing features are introduced.
      </p>

    </div>

  </section>


  <section class="detail-section">

    <div class="detail-index">
      10
    </div>

    <div class="detail-copy">

      <h2>
        Last update
      </h2>

      <p>
        September 2026
      </p>

    </div>

  </section>

</ProjectLayout>