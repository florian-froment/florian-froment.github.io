<script>
  const elements = document.querySelectorAll('.reveal');

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    },
    {
      threshold: 0.15,
    }
  );

  elements.forEach((element) => observer.observe(element));
</script>

<script>
  const heroTitle = document.querySelector('.hero h1');

  window.addEventListener('scroll', () => {
    const scroll = window.scrollY;

    if (heroTitle) {
      heroTitle.style.transform = `translateY(${scroll * 0.08}px)`;
    }
  });
</script>

<script>
  const walker = document.createTreeWalker(
    document.body,
    NodeFilter.SHOW_TEXT
  );

  const textNodes = [];

  while (walker.nextNode()) {
    textNodes.push(walker.currentNode);
  }

  textNodes.forEach((node) => {
    if (!node.nodeValue?.includes('|')) return;

    const parent = node.parentElement;

    // Évite de toucher aux scripts et styles
    if (!parent || ['SCRIPT', 'STYLE'].includes(parent.tagName)) return;

    const fragment = document.createDocumentFragment();

    node.nodeValue.split('|').forEach((part, index, array) => {
      fragment.appendChild(document.createTextNode(part));

      if (index < array.length - 1) {
        const pipe = document.createElement('span');
        pipe.className = 'pipe';
        pipe.textContent = '|';
        fragment.appendChild(pipe);
      }
    });

    node.parentNode?.replaceChild(fragment, node);
  });
</script>

<script>
  const autoLinks = {
    "Tripteron": "/projects/tripteron",
    "KM-RoBoTa": "/experience/km-robota",
    "ICAM": "/education/icam",
    "Silesian University of Technology": "/education/silesian-university",
    "IUT de Figeac": "/education/iut-figeac"
  };

  const walker = document.createTreeWalker(
    document.body,
    NodeFilter.SHOW_TEXT
  );

  const nodes = [];

  while (walker.nextNode()) {
    nodes.push(walker.currentNode);
  }

  nodes.forEach((node) => {
    const parent = node.parentElement;

    if (
      !parent ||
      ["SCRIPT", "STYLE", "A"].includes(parent.tagName)
    ) {
      return;
    }

    let text = node.nodeValue ?? "";

    const matches = Object.keys(autoLinks).filter((word) =>
      text.includes(word)
    );

    if (matches.length === 0) return;

    const fragment = document.createDocumentFragment();

    const regex = new RegExp(
      `(${matches
        .sort((a, b) => b.length - a.length)
        .map((word) =>
          word.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")
        )
        .join("|")})`,
      "g"
    );

    text.split(regex).forEach((part) => {
      if (autoLinks[part]) {
        const link = document.createElement("a");

        link.href = autoLinks[part];
        link.textContent = part;
        link.className = "auto-link";

        fragment.appendChild(link);
      } else {
        fragment.appendChild(
          document.createTextNode(part)
        );
      }
    });

    node.parentNode?.replaceChild(fragment, node);
  });
</script>

