---
import ProjectLayout from "../../layouts/ProjectLayout.astro";
---

<ProjectLayout
  title="IDRA"
  category="Project | Engineering"
  year="2026"
  description="IDRA engineering project."
>

  <p slot="intro" class="hero-intro">
    Development of the IDRA project, focused on engineering design,
    technical exploration and system integration.
  </p>


  <div class="detail-section">

    <p class="detail-index">
      01 | Overview
    </p>

    <div class="detail-copy">

      <h2>
        IDRA.
      </h2>

      <p>
        This project explores the development of an engineering system
        through mechanical design, technical analysis and iterative prototyping.
      </p>

    </div>

  </div>


  <div class="detail-section">

    <p class="detail-index">
      02 | Objectives
    </p>

    <div class="detail-copy">

      <ul>
        <li>Define the project architecture</li>
        <li>Develop the mechanical concept</li>
        <li>Evaluate technical constraints</li>
        <li>Prototype and validate key principles</li>
      </ul>

    </div>

  </div>


  <div class="detail-section">

    <p class="detail-index">
      03 | My contribution
    </p>

    <div class="detail-copy">

      <ul>
        <li>Mechanical design</li>
        <li>Concept development</li>
        <li>Technical analysis</li>
        <li>Prototype development</li>
      </ul>

    </div>

  </div>


  <div class="detail-section">

    <p class="detail-index">
      04 | Tools
    </p>

    <div class="detail-copy">

      <p>
        CATIA V5 | Mechanical Design | Prototyping | Engineering Analysis
      </p>

    </div>

  </div>

</ProjectLayout>
