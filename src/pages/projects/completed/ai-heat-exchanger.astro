---
import ProjectLayout from "../../../layouts/ProjectLayout.astro";
---

<ProjectLayout
  title="AI Heat Exchanger"
  category="Project | Thermal Engineering & AI"
  year="2026"
  description="ICAM engineering project exploring AI-assisted heat exchanger design, optimisation and thermal performance analysis."
>

  <p slot="intro">
    An engineering project developed at ICAM to explore how artificial intelligence
    and computational design can support the development of more efficient and
    better-adapted heat exchanger geometries.
  </p>


  <!-- PROJECT SNAPSHOT -->

  <section class="portfolio-hero">

    <div class="portfolio-outcome">

      <span class="portfolio-kicker">
        Outcome
      </span>

      <h2>
        Using AI to explore thermal design beyond conventional geometries.
      </h2>

      <p>
        The project investigated how AI-assisted design methods could be used to
        generate, compare and refine heat exchanger concepts while considering
        thermal performance, pressure losses, manufacturability and overall geometry.
      </p>

      <div class="portfolio-metrics">

        <div>
          <strong>AI</strong>
          <span>Assisted design exploration</span>
        </div>

        <div>
          <strong>Thermal</strong>
          <span>Performance driven</span>
        </div>

        <div>
          <strong>Iterative</strong>
          <span>Design and validation loop</span>
        </div>

      </div>

    </div>


    <figure class="portfolio-main-visual">

      <img
        src="/images/projects/ai-heat-exchanger/heat-exchanger-main.jpg"
        alt="AI-assisted heat exchanger engineering concept"
      />

      <figcaption>
        Final concept | AI-assisted heat exchanger architecture
      </figcaption>

    </figure>

  </section>


  <!-- 01 | PROBLEM -->

  <section class="detail-section">

    <div class="detail-index">
      01
    </div>

    <div class="detail-copy">

      <h2>
        Engineering problem
      </h2>

      <p>
        Heat exchanger design requires balancing several competing objectives:
        increasing heat transfer, limiting pressure losses, maintaining compactness
        and ensuring that the resulting geometry remains manufacturable.
      </p>

      <p>
        The project explored whether AI-assisted methods could support this design
        process by evaluating a larger range of possible geometries than a purely
        manual approach.
      </p>

    </div>

  </section>


  <!-- 02 | REQUIREMENTS -->

  <section class="portfolio-visual-section">

    <div class="portfolio-section-header">

      <span>
        02 | Requirements
      </span>

      <h2>
        Translating thermal constraints into design objectives.
      </h2>

    </div>


    <div class="process-grid">

      <figure>

        <img
          src="/images/projects/ai-heat-exchanger/requirements.jpg"
          alt="Heat exchanger design requirements"
        />

        <figcaption>
          01 | Thermal and geometric requirements
        </figcaption>

      </figure>


      <figure>

        <img
          src="/images/projects/ai-heat-exchanger/baseline.jpg"
          alt="Reference heat exchanger geometry"
        />

        <figcaption>
          02 | Reference architecture
        </figcaption>

      </figure>


      <figure>

        <img
          src="/images/projects/ai-heat-exchanger/ai-concepts.jpg"
          alt="AI generated heat exchanger concepts"
        />

        <figcaption>
          03 | AI-assisted concept exploration
        </figcaption>

      </figure>

    </div>

  </section>


  <!-- 03 | OBJECTIVES -->

  <section class="detail-section">

    <div class="detail-index">
      03
    </div>

    <div class="detail-copy">

      <h2>
        Design objectives
      </h2>

      <ul>
        <li>
          Improve heat transfer performance
        </li>

        <li>
          Reduce unnecessary pressure losses
        </li>

        <li>
          Increase exchange surface within a limited volume
        </li>

        <li>
          Explore unconventional internal geometries
        </li>

        <li>
          Maintain realistic manufacturing constraints
        </li>

        <li>
          Compare AI-assisted concepts with conventional solutions
        </li>
      </ul>

    </div>

  </section>


  <!-- 04 | MY CONTRIBUTION -->

  <section class="detail-section">

    <div class="detail-index">
      04
    </div>

    <div class="detail-copy">

      <h2>
        My contribution
      </h2>

      <p>
        My contribution focused on connecting the thermal engineering problem
        with the computational design workflow.
      </p>

      <ul>
        <li>
          Defined the main engineering constraints
        </li>

        <li>
          Structured the design exploration methodology
        </li>

        <li>
          Developed and compared heat exchanger concepts
        </li>

        <li>
          Evaluated geometry against thermal objectives
        </li>

        <li>
          Analysed design trade-offs
        </li>

        <li>
          Prepared engineering documentation and project results
        </li>
      </ul>

    </div>

  </section>


  <!-- 05 | AI WORKFLOW -->

  <section class="portfolio-system">

    <div class="portfolio-section-header">

      <span>
        05 | AI workflow
      </span>

      <h2>
        Generate. Evaluate. Refine.
      </h2>

    </div>


    <div class="system-grid">

      <figure class="system-overview">

        <img
          src="/images/projects/ai-heat-exchanger/ai-workflow.jpg"
          alt="AI heat exchanger design workflow"
        />

        <figcaption>
          AI-assisted design and evaluation workflow
        </figcaption>

      </figure>


      <div class="subsystem-stack">

        <figure>

          <img
            src="/images/projects/ai-heat-exchanger/generated-geometry.jpg"
            alt="Generated heat exchanger geometry"
          />

          <figcaption>
            Generated geometry | Internal flow architecture
          </figcaption>

        </figure>


        <div class="subsystem-copy">

          <h3>
            Design exploration
          </h3>

          <p>
            AI-assisted exploration can be used to propose alternative geometries
            based on a set of engineering objectives and geometric constraints.
          </p>

          <p>
            Each concept can then be evaluated and fed back into the design loop
            to progressively identify more promising architectures.
          </p>

        </div>

      </div>

    </div>

  </section>


  <!-- 06 | THERMAL ANALYSIS -->

  <section class="detail-section">

    <div class="detail-index">
      06
    </div>

    <div class="detail-copy">

      <h2>
        Thermal analysis
      </h2>

      <p>
        The generated concepts must ultimately be assessed using engineering
        criteria rather than visual complexity alone.
      </p>

      <p>
        Relevant indicators may include heat transfer, temperature distribution,
        flow uniformity, pressure losses and available exchange surface.
      </p>

    </div>

  </section>


  <!-- ANALYSIS VISUAL -->

  <section class="portfolio-wide-visual">

    <figure>

      <img
        src="/images/projects/ai-heat-exchanger/thermal-analysis.jpg"
        alt="Thermal and fluid analysis of the heat exchanger"
      />

      <figcaption>
        Thermal analysis | Temperature and flow behaviour across the exchanger
      </figcaption>

    </figure>

  </section>


  <!-- 07 | DESIGN TRADE-OFFS -->

  <section class="detail-section">

    <div class="detail-index">
      07
    </div>

    <div class="detail-copy">

      <h2>
        Design trade-offs
      </h2>

      <p>
        Maximising heat transfer alone does not necessarily produce the best
        engineering solution.
      </p>

      <p>
        More complex internal structures can increase exchange surface while also
        increasing flow resistance, manufacturing difficulty or overall cost.
      </p>

      <p>
        The project therefore treated the heat exchanger as a multi-objective
        engineering problem rather than a single performance metric.
      </p>

    </div>

  </section>


  <!-- 08 | MANUFACTURABILITY -->

  <section class="detail-section">

    <div class="detail-index">
      08
    </div>

    <div class="detail-copy">

      <h2>
        Manufacturability
      </h2>

      <p>
        AI-generated geometry is only useful if it can ultimately be manufactured,
        assembled and inspected.
      </p>

      <p>
        Design evaluation therefore also considered the feasibility of producing
        complex internal channels and surfaces using available manufacturing
        processes.
      </p>

      <ul>
        <li>
          Minimum feature size
        </li>

        <li>
          Internal accessibility
        </li>

        <li>
          Surface quality
        </li>

        <li>
          Material compatibility
        </li>

        <li>
          Manufacturing complexity
        </li>
      </ul>

    </div>

  </section>


  <!-- 09 | COMPARISON -->

  <section class="portfolio-visual-section">

    <div class="portfolio-section-header">

      <span>
        09 | Comparison
      </span>

      <h2>
        Conventional versus AI-assisted design.
      </h2>

    </div>


    <div class="process-grid">

      <figure>

        <img
          src="/images/projects/ai-heat-exchanger/conventional.jpg"
          alt="Conventional heat exchanger geometry"
        />

        <figcaption>
          Conventional geometry
        </figcaption>

      </figure>


      <figure>

        <img
          src="/images/projects/ai-heat-exchanger/ai-optimized.jpg"
          alt="AI-assisted heat exchanger geometry"
        />

        <figcaption>
          AI-assisted geometry
        </figcaption>

      </figure>


      <figure>

        <img
          src="/images/projects/ai-heat-exchanger/comparison-results.jpg"
          alt="Comparison of heat exchanger concepts"
        />

        <figcaption>
          Engineering comparison
        </figcaption>

      </figure>

    </div>

  </section>


  <!-- 10 | DOCUMENTATION -->

  <section class="portfolio-documents">

    <div class="portfolio-section-header">

      <span>
        10 | Documentation
      </span>

      <h2>
        Engineering records.
      </h2>

    </div>


    <div class="document-grid">

      <a
        href="/documents/ai-heat-exchanger/project-report.pdf"
        target="_blank"
        class="document-card"
      >

        <div>

          <span class="document-type">
            PDF
          </span>

          <h3>
            Project report
          </h3>

          <p>
            Full engineering methodology, design choices and project conclusions.
          </p>

        </div>

        <span class="document-arrow">
          ↗
        </span>

      </a>


      <a
        href="/documents/ai-heat-exchanger/thermal-study.pdf"
        target="_blank"
        class="document-card"
      >

        <div>

          <span class="document-type">
            PDF
          </span>

          <h3>
            Thermal study
          </h3>

          <p>
            Thermal calculations, simulation results and concept comparison.
          </p>

        </div>

        <span class="document-arrow">
          ↗
        </span>

      </a>


      <a
        href="/documents/ai-heat-exchanger/design-study.pdf"
        target="_blank"
        class="document-card"
      >

        <div>

          <span class="document-type">
            PDF
          </span>

          <h3>
            Design study
          </h3>

          <p>
            Geometry development, CAD concepts and manufacturing considerations.
          </p>

        </div>

        <span class="document-arrow">
          ↗
        </span>

      </a>

    </div>

  </section>


  <!-- 11 | SKILLS -->

  <section class="detail-section">

    <div class="detail-index">
      11
    </div>

    <div class="detail-copy">

      <h2>
        Engineering skills
      </h2>

      <ul>
        <li>
          Thermal engineering
        </li>

        <li>
          Heat exchanger design
        </li>

        <li>
          AI-assisted engineering
        </li>

        <li>
          Computational design
        </li>

        <li>
          Multi-objective optimisation
        </li>

        <li>
          CAD modelling
        </li>

        <li>
          Thermal analysis
        </li>

        <li>
          Design for manufacturing
        </li>
      </ul>

    </div>

  </section>


  <!-- 12 | LEARNING -->

  <section class="detail-section">

    <div class="detail-index">
      12
    </div>

    <div class="detail-copy">

      <h2>
        What I learned
      </h2>

      <p>
        This project showed me that artificial intelligence can be useful in
        engineering when it is treated as a design exploration tool rather than
        as a replacement for physical reasoning.
      </p>

      <p>
        The most relevant concepts still need to be interpreted through thermal,
        fluid, mechanical and manufacturing constraints.
      </p>

      <p>
        The project therefore reinforced the importance of combining computational
        tools with conventional engineering judgement.
      </p>

    </div>

  </section>

</ProjectLayout>


<style>

  .portfolio-hero {
    display: grid;

    grid-template-columns:
      minmax(300px, 0.8fr)
      minmax(500px, 1.8fr);

    gap: 48px;

    align-items: center;

    padding: 40px 0 100px;
  }


  .portfolio-kicker {
    display: block;

    margin-bottom: 18px;

    font-size: 10px;
    font-weight: 650;

    letter-spacing: 0.12em;

    text-transform: uppercase;

    color: var(--text-secondary);
  }


  .portfolio-outcome h2,
  .portfolio-section-header h2 {
    margin: 0;

    font-size: clamp(38px, 5vw, 72px);

    line-height: 0.98;

    letter-spacing: -0.05em;
  }


  .portfolio-outcome > p {
    margin-top: 26px;

    max-width: 520px;

    font-size: 17px;
    line-height: 1.6;

    color: var(--text-secondary);
  }


  .portfolio-metrics {
    display: grid;

    gap: 18px;

    margin-top: 40px;
  }


  .portfolio-metrics div {
    padding-top: 14px;

    border-top: 1px solid var(--border);
  }


  .portfolio-metrics strong {
    display: block;

    margin-bottom: 4px;

    font-size: 24px;

    color: var(--text);
  }


  .portfolio-metrics span {
    font-size: 12px;

    color: var(--text-secondary);
  }


  .portfolio-main-visual img,
  .process-grid img,
  .system-grid img,
  .portfolio-wide-visual img {
    width: 100%;

    display: block;

    object-fit: cover;

    background: #e8e8ea;
  }


  .portfolio-main-visual img {
    aspect-ratio: 4 / 3;
  }


  figure {
    margin: 0;
  }


  figcaption {
    margin-top: 10px;

    font-size: 11px;
    line-height: 1.4;

    color: var(--text-secondary);
  }


  .portfolio-visual-section,
  .portfolio-system,
  .portfolio-documents {
    padding: 100px 0;

    border-top: 1px solid var(--border);
  }


  .portfolio-section-header {
    display: grid;

    grid-template-columns: 1fr 3fr;

    gap: 40px;

    margin-bottom: 56px;
  }


  .portfolio-section-header > span {
    font-size: 12px;

    color: var(--text-secondary);
  }


  .process-grid {
    display: grid;

    grid-template-columns:
      repeat(3, 1fr);

    gap: 22px;
  }


  .process-grid img {
    aspect-ratio: 4 / 3;
  }


  .system-grid {
    display: grid;

    grid-template-columns: 1.8fr 1fr;

    gap: 24px;
  }


  .system-overview img {
    aspect-ratio: 4 / 3;
  }


  .subsystem-stack {
    display: grid;

    gap: 28px;
  }


  .subsystem-stack img {
    aspect-ratio: 4 / 3;
  }


  .subsystem-copy h3 {
    margin-bottom: 14px;

    font-size: 24px;
  }


  .subsystem-copy p {
    font-size: 15px;
    line-height: 1.6;

    color: var(--text-secondary);
  }


  .portfolio-wide-visual {
    padding: 80px 0 100px;
  }


  .portfolio-wide-visual img {
    max-height: 720px;

    object-fit: cover;

    aspect-ratio: 16 / 8;
  }


  .document-grid {
    display: grid;

    grid-template-columns:
      repeat(3, 1fr);

    gap: 16px;
  }


  .document-card {
    min-height: 220px;

    display: flex;

    justify-content: space-between;

    padding: 24px;

    border: 1px solid var(--border);

    color: var(--text);

    text-decoration: none;

    transition:
      border-color 0.2s ease,
      transform 0.2s ease,
      background 0.2s ease;
  }


  .document-card:hover {
    border-color: #d60000;

    background: rgba(214, 0, 0, 0.025);

    transform: translateY(-3px);
  }


  .document-type {
    display: block;

    margin-bottom: 34px;

    font-size: 9px;
    font-weight: 650;

    letter-spacing: 0.12em;

    color: #d60000;
  }


  .document-card h3 {
    margin-bottom: 10px;

    font-size: 20px;
  }


  .document-card p {
    max-width: 260px;

    font-size: 13px;
    line-height: 1.5;

    color: var(--text-secondary);
  }


  .document-arrow {
    align-self: flex-start;

    font-size: 16px;
  }


  @media (max-width: 900px) {

    .portfolio-hero,
    .system-grid {
      grid-template-columns: 1fr;
    }


    .process-grid,
    .document-grid {
      grid-template-columns: 1fr;
    }


    .portfolio-section-header {
      grid-template-columns: 1fr;

      gap: 18px;
    }

  }

</style>