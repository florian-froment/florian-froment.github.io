---
import ProjectLayout from "../../../layouts/ProjectLayout.astro";
---

<ProjectLayout
  title="E-Bike"
  category="Project | Electric Vehicle"
  year="2023"
  description="Mechanical engineering project developed at IUT Figeac around the design of a compact electric mini-motorcycle."
>

  <p slot="intro">
    A compact electric vehicle project developed at IUT Figeac,
    combining mechanical design, frame architecture, drivetrain integration
    and packaging within a small-scale motorcycle platform.
  </p>


  <!-- PROJECT SNAPSHOT -->

  <section class="portfolio-hero">

    <div class="portfolio-outcome">

      <span class="portfolio-kicker">
        Outcome
      </span>

      <h2>
        Packaging an electric powertrain into a compact mechanical platform.
      </h2>

      <p>
        The project focused on designing a mini electric motorcycle by integrating
        the frame, drivetrain, steering, braking and energy-storage systems into
        a compact and coherent architecture.
      </p>

      <div class="portfolio-metrics">

        <div>
          <strong>Electric</strong>
          <span>Compact powertrain</span>
        </div>

        <div>
          <strong>Mechanical</strong>
          <span>Frame and vehicle architecture</span>
        </div>

        <div>
          <strong>Prototype</strong>
          <span>Design and assembly</span>
        </div>

      </div>

    </div>


    <figure class="portfolio-main-visual">

      <img
        src="/images/projects/e-bike/e-bike-main.jpg"
        alt="Electric mini-motorcycle engineering project"
      />

      <figcaption>
        Final concept | Compact electric mini-motorcycle
      </figcaption>

    </figure>

  </section>


  <!-- 01 | CONTEXT -->

  <section class="detail-section">

    <div class="detail-index">
      01
    </div>

    <div class="detail-copy">

      <h2>
        Context
      </h2>

      <p>
        The project was developed during my mechanical engineering studies
        at IUT Figeac.
      </p>

      <p>
        The objective was to design a compact electric two-wheeler while considering
        the same interactions found in a larger vehicle: structure, drivetrain,
        ergonomics, braking, steering and packaging.
      </p>

    </div>

  </section>


  <!-- 02 | REQUIREMENTS -->

  <section class="portfolio-visual-section">

    <div class="portfolio-section-header">

      <span>
        02 | Requirements
      </span>

      <h2>
        Designing around space, mass and function.
      </h2>

    </div>


    <div class="process-grid">

      <figure>

        <img
          src="/images/projects/e-bike/initial-sketch.jpg"
          alt="Initial sketches of the electric mini-motorcycle"
        />

        <figcaption>
          01 | Initial architecture
        </figcaption>

      </figure>


      <figure>

        <img
          src="/images/projects/e-bike/packaging-study.jpg"
          alt="Packaging study of the electric mini-motorcycle"
        />

        <figcaption>
          02 | Component packaging
        </figcaption>

      </figure>


      <figure>

        <img
          src="/images/projects/e-bike/cad-concept.jpg"
          alt="CAD concept of the electric mini-motorcycle"
        />

        <figcaption>
          03 | CAD development
        </figcaption>

      </figure>

    </div>

  </section>


  <!-- 03 | DESIGN OBJECTIVES -->

  <section class="detail-section">

    <div class="detail-index">
      03
    </div>

    <div class="detail-copy">

      <h2>
        Design objectives
      </h2>

      <ul>
        <li>
          Create a compact and rigid frame architecture
        </li>

        <li>
          Integrate electric motor and transmission components
        </li>

        <li>
          Position the battery within the available volume
        </li>

        <li>
          Maintain a balanced mass distribution
        </li>

        <li>
          Integrate steering and braking systems
        </li>

        <li>
          Ensure realistic manufacturing and assembly
        </li>
      </ul>

    </div>

  </section>


  <!-- 04 | MY CONTRIBUTION -->

  <section class="detail-section">

    <div class="detail-index">
      04
    </div>

    <div class="detail-copy">

      <h2>
        My contribution
      </h2>

      <ul>
        <li>
          Contributed to the overall vehicle architecture
        </li>

        <li>
          Developed mechanical components in CAD
        </li>

        <li>
          Worked on frame and subsystem integration
        </li>

        <li>
          Studied drivetrain packaging
        </li>

        <li>
          Considered assembly and manufacturing constraints
        </li>

        <li>
          Participated in prototype development and validation
        </li>
      </ul>

    </div>

  </section>


  <!-- 05 | SYSTEM ARCHITECTURE -->

  <section class="portfolio-system">

    <div class="portfolio-section-header">

      <span>
        05 | Architecture
      </span>

      <h2>
        One compact system. Multiple mechanical functions.
      </h2>

    </div>


    <div class="system-grid">

      <figure class="system-overview">

        <img
          src="/images/projects/e-bike/system-overview.jpg"
          alt="Overall architecture of the electric mini-motorcycle"
        />

        <figcaption>
          Overall vehicle architecture
        </figcaption>

      </figure>


      <div class="subsystem-stack">

        <figure>

          <img
            src="/images/projects/e-bike/drivetrain-detail.jpg"
            alt="Electric drivetrain detail of the mini-motorcycle"
          />

          <figcaption>
            Drivetrain | Motor and transmission integration
          </figcaption>

        </figure>


        <div class="subsystem-copy">

          <h3>
            Packaging
          </h3>

          <p>
            The compact dimensions of the vehicle required careful positioning
            of the major components inside a limited mechanical envelope.
          </p>

          <p>
            Motor, battery, transmission and structural components had to be
            integrated without compromising ergonomics or assembly access.
          </p>

        </div>

      </div>

    </div>

  </section>


  <!-- 06 | FRAME -->

  <section class="detail-section">

    <div class="detail-index">
      06
    </div>

    <div class="detail-copy">

      <h2>
        Frame design
      </h2>

      <p>
        The frame forms the structural backbone of the vehicle and determines
        the relative position of most mechanical subsystems.
      </p>

      <p>
        Its design therefore had to balance stiffness, mass, manufacturability
        and component accessibility.
      </p>

    </div>

  </section>


  <!-- 07 | DRIVETRAIN -->

  <section class="detail-section">

    <div class="detail-index">
      07
    </div>

    <div class="detail-copy">

      <h2>
        Electric drivetrain
      </h2>

      <p>
        The propulsion system required the integration of an electric motor,
        transmission and rear-wheel drive within a small available volume.
      </p>

      <p>
        The architecture had to maintain suitable alignment between the motor,
        transmission components and driven wheel while limiting unnecessary
        mechanical complexity.
      </p>

    </div>

  </section>


  <!-- 08 | BATTERY -->

  <section class="detail-section">

    <div class="detail-index">
      08
    </div>

    <div class="detail-copy">

      <h2>
        Battery integration
      </h2>

      <p>
        Battery placement influences both packaging and vehicle behaviour.
      </p>

      <p>
        The project therefore considered available volume, centre of gravity,
        accessibility and protection when defining the battery location.
      </p>

    </div>

  </section>


  <!-- WIDE VISUAL -->

  <section class="portfolio-wide-visual">

    <figure>

      <img
        src="/images/projects/e-bike/cad-assembly.jpg"
        alt="Complete CAD assembly of the electric mini-motorcycle"
      />

      <figcaption>
        CAD assembly | Frame, drivetrain and subsystem integration
      </figcaption>

    </figure>

  </section>


  <!-- 09 | VEHICLE DYNAMICS -->

  <section class="detail-section">

    <div class="detail-index">
      09
    </div>

    <div class="detail-copy">

      <h2>
        Vehicle dynamics
      </h2>

      <p>
        Even at a small scale, vehicle geometry influences stability,
        steering response and rider behaviour.
      </p>

      <p>
        Wheelbase, mass distribution, steering geometry and component position
        were therefore important elements of the mechanical architecture.
      </p>

    </div>

  </section>


  <!-- 10 | MANUFACTURING -->

  <section class="detail-section">

    <div class="detail-index">
      10
    </div>

    <div class="detail-copy">

      <h2>
        Manufacturing & assembly
      </h2>

      <p>
        The design had to remain compatible with available manufacturing methods
        and realistic workshop assembly.
      </p>

      <ul>
        <li>
          Component accessibility
        </li>

        <li>
          Mechanical interfaces
        </li>

        <li>
          Assembly sequence
        </li>

        <li>
          Manufacturing simplicity
        </li>

        <li>
          Maintenance accessibility
        </li>
      </ul>

    </div>

  </section>


  <!-- 11 | DEVELOPMENT -->

  <section class="portfolio-visual-section">

    <div class="portfolio-section-header">

      <span>
        11 | Development
      </span>

      <h2>
        Concept. CAD. Build. Test.
      </h2>

    </div>


    <div class="process-grid">

      <figure>

        <img
          src="/images/projects/e-bike/design-v1.jpg"
          alt="First design iteration of the mini-motorcycle"
        />

        <figcaption>
          V1 | Initial layout
        </figcaption>

      </figure>


      <figure>

        <img
          src="/images/projects/e-bike/design-v2.jpg"
          alt="Second design iteration of the mini-motorcycle"
        />

        <figcaption>
          V2 | Packaging refinement
        </figcaption>

      </figure>


      <figure>

        <img
          src="/images/projects/e-bike/prototype.jpg"
          alt="Prototype of the electric mini-motorcycle"
        />

        <figcaption>
          Prototype | Physical implementation
        </figcaption>

      </figure>

    </div>

  </section>


  <!-- 12 | DOCUMENTATION -->

  <section class="portfolio-documents">

    <div class="portfolio-section-header">

      <span>
        12 | Documentation
      </span>

      <h2>
        Engineering records.
      </h2>

    </div>


    <div class="document-grid">

      <a
        href="/documents/e-bike/project-report.pdf"
        target="_blank"
        class="document-card"
      >

        <div>

          <span class="document-type">
            PDF
          </span>

          <h3>
            Project report
          </h3>

          <p>
            Requirements, mechanical architecture and project conclusions.
          </p>

        </div>

        <span class="document-arrow">
          ↗
        </span>

      </a>


      <a
        href="/documents/e-bike/technical-drawings.pdf"
        target="_blank"
        class="document-card"
      >

        <div>

          <span class="document-type">
            PDF
          </span>

          <h3>
            Technical drawings
          </h3>

          <p>
            Selected mechanical drawings and component definitions.
          </p>

        </div>

        <span class="document-arrow">
          ↗
        </span>

      </a>


      <a
        href="/documents/e-bike/design-review.pdf"
        target="_blank"
        class="document-card"
      >

        <div>

          <span class="document-type">
            PDF
          </span>

          <h3>
            Design review
          </h3>

          <p>
            Design iterations, packaging decisions and engineering review.
          </p>

        </div>

        <span class="document-arrow">
          ↗
        </span>

      </a>

    </div>

  </section>


  <!-- 13 | SKILLS -->

  <section class="detail-section">

    <div class="detail-index">
      13
    </div>

    <div class="detail-copy">

      <h2>
        Engineering skills
      </h2>

      <ul>
        <li>
          Vehicle architecture
        </li>

        <li>
          Mechanical design
        </li>

        <li>
          Electric drivetrain integration
        </li>

        <li>
          CAD modelling
        </li>

        <li>
          Structural design
        </li>

        <li>
          Packaging
        </li>

        <li>
          Design for manufacturing
        </li>

        <li>
          Prototype development
        </li>
      </ul>

    </div>

  </section>


  <!-- 14 | LEARNING -->

  <section class="detail-section">

    <div class="detail-index">
      14
    </div>

    <div class="detail-copy">

      <h2>
        What I learned
      </h2>

      <p>
        The project showed me how quickly mechanical design becomes a system-level
        problem once several functions must coexist within the same envelope.
      </p>

      <p>
        Frame geometry, drivetrain position, battery packaging, ergonomics and
        manufacturing constraints all influenced one another.
      </p>

      <p>
        It strengthened my interest in compact mechanical systems and complete
        product architecture.
      </p>

    </div>

  </section>

</ProjectLayout>


<style>

  .portfolio-hero {
    display: grid;

    grid-template-columns:
      minmax(300px, 0.8fr)
      minmax(500px, 1.8fr);

    gap: 48px;

    align-items: center;

    padding: 40px 0 100px;
  }


  .portfolio-kicker {
    display: block;

    margin-bottom: 18px;

    font-size: 10px;
    font-weight: 650;

    letter-spacing: 0.12em;

    text-transform: uppercase;

    color: var(--text-secondary);
  }


  .portfolio-outcome h2,
  .portfolio-section-header h2 {
    margin: 0;

    font-size: clamp(38px, 5vw, 72px);

    line-height: 0.98;

    letter-spacing: -0.05em;
  }


  .portfolio-outcome > p {
    margin-top: 26px;

    max-width: 520px;

    font-size: 17px;
    line-height: 1.6;

    color: var(--text-secondary);
  }


  .portfolio-metrics {
    display: grid;

    gap: 18px;

    margin-top: 40px;
  }


  .portfolio-metrics div {
    padding-top: 14px;

    border-top: 1px solid var(--border);
  }


  .portfolio-metrics strong {
    display: block;

    margin-bottom: 4px;

    font-size: 24px;

    color: var(--text);
  }


  .portfolio-metrics span {
    font-size: 12px;

    color: var(--text-secondary);
  }


  .portfolio-main-visual img,
  .process-grid img,
  .system-grid img,
  .portfolio-wide-visual img {
    width: 100%;

    display: block;

    object-fit: cover;

    background: #e8e8ea;
  }


  .portfolio-main-visual img {
    aspect-ratio: 4 / 3;
  }


  figure {
    margin: 0;
  }


  figcaption {
    margin-top: 10px;

    font-size: 11px;
    line-height: 1.4;

    color: var(--text-secondary);
  }


  .portfolio-visual-section,
  .portfolio-system,
  .portfolio-documents {
    padding: 100px 0;

    border-top: 1px solid var(--border);
  }


  .portfolio-section-header {
    display: grid;

    grid-template-columns: 1fr 3fr;

    gap: 40px;

    margin-bottom: 56px;
  }


  .portfolio-section-header > span {
    font-size: 12px;

    color: var(--text-secondary);
  }


  .process-grid {
    display: grid;

    grid-template-columns:
      repeat(3, 1fr);

    gap: 22px;
  }


  .process-grid img {
    aspect-ratio: 4 / 3;
  }


  .system-grid {
    display: grid;

    grid-template-columns: 1.8fr 1fr;

    gap: 24px;
  }


  .system-overview img {
    aspect-ratio: 4 / 3;
  }


  .subsystem-stack {
    display: grid;

    gap: 28px;
  }


  .subsystem-stack img {
    aspect-ratio: 4 / 3;
  }


  .subsystem-copy h3 {
    margin-bottom: 14px;

    font-size: 24px;
  }


  .subsystem-copy p {
    font-size: 15px;
    line-height: 1.6;

    color: var(--text-secondary);
  }


  .portfolio-wide-visual {
    padding: 80px 0 100px;
  }


  .portfolio-wide-visual img {
    max-height: 720px;

    object-fit: cover;

    aspect-ratio: 16 / 8;
  }


  .document-grid {
    display: grid;

    grid-template-columns:
      repeat(3, 1fr);

    gap: 16px;
  }


  .document-card {
    min-height: 220px;

    display: flex;

    justify-content: space-between;

    padding: 24px;

    border: 1px solid var(--border);

    color: var(--text);

    text-decoration: none;

    transition:
      border-color 0.2s ease,
      transform 0.2s ease,
      background 0.2s ease;
  }


  .document-card:hover {
    border-color: #d60000;

    background: rgba(214, 0, 0, 0.025);

    transform: translateY(-3px);
  }


  .document-type {
    display: block;

    margin-bottom: 34px;

    font-size: 9px;
    font-weight: 650;

    letter-spacing: 0.12em;

    color: #d60000;
  }


  .document-card h3 {
    margin-bottom: 10px;

    font-size: 20px;
  }


  .document-card p {
    max-width: 260px;

    font-size: 13px;
    line-height: 1.5;

    color: var(--text-secondary);
  }


  .document-arrow {
    align-self: flex-start;

    font-size: 16px;
  }


  @media (max-width: 900px) {

    .portfolio-hero,
    .system-grid {
      grid-template-columns: 1fr;
    }


    .process-grid,
    .document-grid {
      grid-template-columns: 1fr;
    }


    .portfolio-section-header {
      grid-template-columns: 1fr;

      gap: 18px;
    }

  }

</style>