---
import ProjectLayout from "../../../layouts/ProjectLayout.astro";
---

<ProjectLayout
  title="Aviation Fuse"
  category="Project | Aeronautical Structures"
  year="2023"
  description="Engineering project developed at IUT Figeac around the design and study of a glider fuselage structure."
>

  <p slot="intro">
    An aeronautical engineering project focused on the structural design,
    mechanical architecture and manufacturability of a glider fuselage.
  </p>


  <!-- PROJECT SNAPSHOT -->

  <section class="portfolio-hero">

    <div class="portfolio-outcome">

      <span class="portfolio-kicker">
        Outcome
      </span>

      <h2>
        Designing a lightweight structure around aerodynamic constraints.
      </h2>

      <p>
        Aviation Fuse explored the design of a glider fuselage by combining
        structural requirements, geometry, manufacturing constraints and the need
        to minimise unnecessary mass.
      </p>

      <div class="portfolio-metrics">

        <div>
          <strong>Aeronautical</strong>
          <span>Structural design</span>
        </div>

        <div>
          <strong>Lightweight</strong>
          <span>Mass-conscious architecture</span>
        </div>

        <div>
          <strong>CAD</strong>
          <span>Design and technical definition</span>
        </div>

      </div>

    </div>


    <figure class="portfolio-main-visual">

      <img
        src="/images/projects/aviation-fuse/fuselage-main.jpg"
        alt="Glider fuselage engineering project"
      />

      <figcaption>
        Final concept | Glider fuselage structural architecture
      </figcaption>

    </figure>

  </section>


  <!-- 01 | CONTEXT -->

  <section class="detail-section">

    <div class="detail-index">
      01
    </div>

    <div class="detail-copy">

      <h2>
        Context
      </h2>

      <p>
        The project was developed during my mechanical engineering studies at
        IUT Figeac.
      </p>

      <p>
        The objective was to study the design of a glider fuselage as a complete
        mechanical system rather than as an isolated geometric shell.
      </p>

      <p>
        The fuselage had to integrate aerodynamic shape, structural continuity,
        assembly constraints and realistic manufacturing considerations.
      </p>

    </div>

  </section>


  <!-- 02 | REQUIREMENTS -->

  <section class="portfolio-visual-section">

    <div class="portfolio-section-header">

      <span>
        02 | Requirements
      </span>

      <h2>
        Turning flight constraints into mechanical architecture.
      </h2>

    </div>


    <div class="process-grid">

      <figure>

        <img
          src="/images/projects/aviation-fuse/initial-sketch.jpg"
          alt="Initial sketches of the glider fuselage"
        />

        <figcaption>
          01 | Initial geometry and layout
        </figcaption>

      </figure>


      <figure>

        <img
          src="/images/projects/aviation-fuse/requirements.jpg"
          alt="Glider fuselage design requirements"
        />

        <figcaption>
          02 | Structural and geometric requirements
        </figcaption>

      </figure>


      <figure>

        <img
          src="/images/projects/aviation-fuse/cad-concept.jpg"
          alt="CAD concept of the glider fuselage"
        />

        <figcaption>
          03 | CAD architecture
        </figcaption>

      </figure>

    </div>

  </section>


  <!-- 03 | OBJECTIVES -->

  <section class="detail-section">

    <div class="detail-index">
      03
    </div>

    <div class="detail-copy">

      <h2>
        Design objectives
      </h2>

      <ul>
        <li>
          Maintain structural continuity along the fuselage
        </li>

        <li>
          Reduce unnecessary structural mass
        </li>

        <li>
          Preserve the required aerodynamic envelope
        </li>

        <li>
          Integrate internal structural elements
        </li>

        <li>
          Allow realistic manufacturing and assembly
        </li>

        <li>
          Produce a complete technical definition
        </li>
      </ul>

    </div>

  </section>


  <!-- 04 | MY CONTRIBUTION -->

  <section class="detail-section">

    <div class="detail-index">
      04
    </div>

    <div class="detail-copy">

      <h2>
        My contribution
      </h2>

      <ul>
        <li>
          Participated in the definition of the fuselage architecture
        </li>

        <li>
          Developed CAD geometry
        </li>

        <li>
          Worked on structural layout and component integration
        </li>

        <li>
          Considered assembly and manufacturing constraints
        </li>

        <li>
          Produced technical drawings and design documentation
        </li>

        <li>
          Contributed to design review and iteration
        </li>
      </ul>

    </div>

  </section>


  <!-- 05 | STRUCTURAL ARCHITECTURE -->

  <section class="portfolio-system">

    <div class="portfolio-section-header">

      <span>
        05 | Structure
      </span>

      <h2>
        The fuselage as a load-carrying system.
      </h2>

    </div>


    <div class="system-grid">

      <figure class="system-overview">

        <img
          src="/images/projects/aviation-fuse/system-overview.jpg"
          alt="Overall glider fuselage structure"
        />

        <figcaption>
          Overall structural architecture
        </figcaption>

      </figure>


      <div class="subsystem-stack">

        <figure>

          <img
            src="/images/projects/aviation-fuse/frame-detail.jpg"
            alt="Detailed structural frame of the glider fuselage"
          />

          <figcaption>
            Structural detail | Frames and internal geometry
          </figcaption>

        </figure>


        <div class="subsystem-copy">

          <h3>
            Structural organisation
          </h3>

          <p>
            The geometry of the fuselage had to provide sufficient structural
            continuity while remaining compatible with the external aerodynamic
            form.
          </p>

          <p>
            Internal elements therefore had to be positioned according to both
            mechanical load transfer and available internal volume.
          </p>

        </div>

      </div>

    </div>

  </section>


  <!-- 06 | LIGHTWEIGHT DESIGN -->

  <section class="detail-section">

    <div class="detail-index">
      06
    </div>

    <div class="detail-copy">

      <h2>
        Lightweight design
      </h2>

      <p>
        Mass is a critical parameter in glider design because unnecessary
        structural weight directly affects flight performance.
      </p>

      <p>
        The design process therefore required balancing stiffness and structural
        robustness against the need to minimise material and component mass.
      </p>

      <p>
        The project introduced me to the logic of designing only the structure
        that is mechanically necessary.
      </p>

    </div>

  </section>


  <!-- 07 | CAD -->

  <section class="portfolio-wide-visual">

    <figure>

      <img
        src="/images/projects/aviation-fuse/cad-assembly.jpg"
        alt="Complete CAD assembly of the glider fuselage"
      />

      <figcaption>
        CAD assembly | Integration of fuselage geometry and structural components
      </figcaption>

    </figure>

  </section>


  <!-- 08 | MANUFACTURABILITY -->

  <section class="detail-section">

    <div class="detail-index">
      08
    </div>

    <div class="detail-copy">

      <h2>
        Manufacturability
      </h2>

      <p>
        The project also required considering how the designed fuselage could
        realistically be produced and assembled.
      </p>

      <ul>
        <li>
          Accessibility for manufacturing
        </li>

        <li>
          Assembly sequence
        </li>

        <li>
          Geometric tolerances
        </li>

        <li>
          Interfaces between structural elements
        </li>

        <li>
          Technical drawing definition
        </li>
      </ul>

      <p>
        This made manufacturing constraints part of the design process rather
        than a consideration added after the geometry was completed.
      </p>

    </div>

  </section>


  <!-- 09 | ITERATION -->

  <section class="detail-section">

    <div class="detail-index">
      09
    </div>

    <div class="detail-copy">

      <h2>
        Design iteration
      </h2>

      <p>
        The fuselage evolved through several design iterations as structural,
        geometric and manufacturing constraints were progressively integrated.
      </p>

      <p>
        Each iteration provided a better understanding of how local design
        decisions could influence the complete aircraft structure.
      </p>

    </div>

  </section>


  <!-- PROCESS VISUALS -->

  <section class="portfolio-visual-section">

    <div class="portfolio-section-header">

      <span>
        10 | Development
      </span>

      <h2>
        Sketch. Model. Review. Refine.
      </h2>

    </div>


    <div class="process-grid">

      <figure>

        <img
          src="/images/projects/aviation-fuse/design-v1.jpg"
          alt="First fuselage design iteration"
        />

        <figcaption>
          V1 | Initial architecture
        </figcaption>

      </figure>


      <figure>

        <img
          src="/images/projects/aviation-fuse/design-v2.jpg"
          alt="Second fuselage design iteration"
        />

        <figcaption>
          V2 | Structural refinement
        </figcaption>

      </figure>


      <figure>

        <img
          src="/images/projects/aviation-fuse/final-design.jpg"
          alt="Final glider fuselage design"
        />

        <figcaption>
          Final | Integrated fuselage architecture
        </figcaption>

      </figure>

    </div>

  </section>


  <!-- 11 | DOCUMENTATION -->

  <section class="portfolio-documents">

    <div class="portfolio-section-header">

      <span>
        11 | Documentation
      </span>

      <h2>
        Engineering records.
      </h2>

    </div>


    <div class="document-grid">

      <a
        href="/documents/aviation-fuse/project-report.pdf"
        target="_blank"
        class="document-card"
      >

        <div>

          <span class="document-type">
            PDF
          </span>

          <h3>
            Project report
          </h3>

          <p>
            Project requirements, design methodology and technical conclusions.
          </p>

        </div>

        <span class="document-arrow">
          ↗
        </span>

      </a>


      <a
        href="/documents/aviation-fuse/technical-drawings.pdf"
        target="_blank"
        class="document-card"
      >

        <div>

          <span class="document-type">
            PDF
          </span>

          <h3>
            Technical drawings
          </h3>

          <p>
            Selected drawings and mechanical definitions of the fuselage.
          </p>

        </div>

        <span class="document-arrow">
          ↗
        </span>

      </a>


      <a
        href="/documents/aviation-fuse/design-review.pdf"
        target="_blank"
        class="document-card"
      >

        <div>

          <span class="document-type">
            PDF
          </span>

          <h3>
            Design review
          </h3>

          <p>
            Design iterations, engineering choices and project review material.
          </p>

        </div>

        <span class="document-arrow">
          ↗
        </span>

      </a>

    </div>

  </section>


  <!-- 12 | SKILLS -->

  <section class="detail-section">

    <div class="detail-index">
      12
    </div>

    <div class="detail-copy">

      <h2>
        Engineering skills
      </h2>

      <ul>
        <li>
          Aeronautical mechanical design
        </li>

        <li>
          Structural architecture
        </li>

        <li>
          Lightweight design
        </li>

        <li>
          CAD modelling
        </li>

        <li>
          Technical drawing
        </li>

        <li>
          Design for manufacturing
        </li>

        <li>
          Assembly integration
        </li>

        <li>
          Design iteration
        </li>
      </ul>

    </div>

  </section>


  <!-- 13 | LEARNING -->

  <section class="detail-section">

    <div class="detail-index">
      13
    </div>

    <div class="detail-copy">

      <h2>
        What I learned
      </h2>

      <p>
        Aviation Fuse was one of my first projects where mechanical design had
        to be considered at the scale of a complete aeronautical structure.
      </p>

      <p>
        It showed me how geometry, mass, stiffness, manufacturing and assembly
        are interconnected throughout the design process.
      </p>

      <p>
        The project also strengthened my interest in aerospace engineering and
        lightweight structural design.
      </p>

    </div>

  </section>

</ProjectLayout>


<style>

  .portfolio-hero {
    display: grid;

    grid-template-columns:
      minmax(300px, 0.8fr)
      minmax(500px, 1.8fr);

    gap: 48px;

    align-items: center;

    padding: 40px 0 100px;
  }


  .portfolio-kicker {
    display: block;

    margin-bottom: 18px;

    font-size: 10px;
    font-weight: 650;

    letter-spacing: 0.12em;

    text-transform: uppercase;

    color: var(--text-secondary);
  }


  .portfolio-outcome h2,
  .portfolio-section-header h2 {
    margin: 0;

    font-size: clamp(38px, 5vw, 72px);

    line-height: 0.98;

    letter-spacing: -0.05em;
  }


  .portfolio-outcome > p {
    margin-top: 26px;

    max-width: 520px;

    font-size: 17px;
    line-height: 1.6;

    color: var(--text-secondary);
  }


  .portfolio-metrics {
    display: grid;

    gap: 18px;

    margin-top: 40px;
  }


  .portfolio-metrics div {
    padding-top: 14px;

    border-top: 1px solid var(--border);
  }


  .portfolio-metrics strong {
    display: block;

    margin-bottom: 4px;

    font-size: 24px;

    color: var(--text);
  }


  .portfolio-metrics span {
    font-size: 12px;

    color: var(--text-secondary);
  }


  .portfolio-main-visual img,
  .process-grid img,
  .system-grid img,
  .portfolio-wide-visual img {
    width: 100%;

    display: block;

    object-fit: cover;

    background: #e8e8ea;
  }


  .portfolio-main-visual img {
    aspect-ratio: 4 / 3;
  }


  figure {
    margin: 0;
  }


  figcaption {
    margin-top: 10px;

    font-size: 11px;
    line-height: 1.4;

    color: var(--text-secondary);
  }


  .portfolio-visual-section,
  .portfolio-system,
  .portfolio-documents {
    padding: 100px 0;

    border-top: 1px solid var(--border);
  }


  .portfolio-section-header {
    display: grid;

    grid-template-columns: 1fr 3fr;

    gap: 40px;

    margin-bottom: 56px;
  }


  .portfolio-section-header > span {
    font-size: 12px;

    color: var(--text-secondary);
  }


  .process-grid {
    display: grid;

    grid-template-columns:
      repeat(3, 1fr);

    gap: 22px;
  }


  .process-grid img {
    aspect-ratio: 4 / 3;
  }


  .system-grid {
    display: grid;

    grid-template-columns: 1.8fr 1fr;

    gap: 24px;
  }


  .system-overview img {
    aspect-ratio: 4 / 3;
  }


  .subsystem-stack {
    display: grid;

    gap: 28px;
  }


  .subsystem-stack img {
    aspect-ratio: 4 / 3;
  }


  .subsystem-copy h3 {
    margin-bottom: 14px;

    font-size: 24px;
  }


  .subsystem-copy p {
    font-size: 15px;
    line-height: 1.6;

    color: var(--text-secondary);
  }


  .portfolio-wide-visual {
    padding: 80px 0 100px;
  }


  .portfolio-wide-visual img {
    max-height: 720px;

    object-fit: cover;

    aspect-ratio: 16 / 8;
  }


  .document-grid {
    display: grid;

    grid-template-columns:
      repeat(3, 1fr);

    gap: 16px;
  }


  .document-card {
    min-height: 220px;

    display: flex;

    justify-content: space-between;

    padding: 24px;

    border: 1px solid var(--border);

    color: var(--text);

    text-decoration: none;

    transition:
      border-color 0.2s ease,
      transform 0.2s ease,
      background 0.2s ease;
  }


  .document-card:hover {
    border-color: #d60000;

    background: rgba(214, 0, 0, 0.025);

    transform: translateY(-3px);
  }


  .document-type {
    display: block;

    margin-bottom: 34px;

    font-size: 9px;
    font-weight: 650;

    letter-spacing: 0.12em;

    color: #d60000;
  }


  .document-card h3 {
    margin-bottom: 10px;

    font-size: 20px;
  }


  .document-card p {
    max-width: 260px;

    font-size: 13px;
    line-height: 1.5;

    color: var(--text-secondary);
  }


  .document-arrow {
    align-self: flex-start;

    font-size: 16px;
  }


  @media (max-width: 900px) {

    .portfolio-hero,
    .system-grid {
      grid-template-columns: 1fr;
    }


    .process-grid,
    .document-grid {
      grid-template-columns: 1fr;
    }


    .portfolio-section-header {
      grid-template-columns: 1fr;

      gap: 18px;
    }

  }

</style>