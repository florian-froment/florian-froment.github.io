---
import ProjectLayout from "../../../layouts/ProjectLayout.astro";
---

<ProjectLayout
  title="Human Arm"
  category="Project | Biomimetic Robotics"
  year="2025"
  description="Design and prototyping of a lightweight biomimetic robotic arm focused on joint architecture, range of motion and human-inspired mechanical behaviour."
>

  <p slot="intro">
    A lightweight biomimetic robotic arm developed to explore how joint geometry,
    mechanical architecture and compliant motion can reproduce part of the
    versatility of the human upper limb.
  </p>


  <!-- PROJECT SNAPSHOT -->

  <section class="portfolio-hero">

    <div class="portfolio-outcome">

      <span class="portfolio-kicker">
        Outcome
      </span>

      <h2>
        Designing motion into the mechanism.
      </h2>

      <p>
        I designed and prototyped a lightweight flexible arm-joint architecture
        intended to reproduce a wider, more human-like range of motion while
        keeping the mechanical structure compact and lightweight.
      </p>

      <div class="portfolio-metrics">

        <div>
          <strong>+75%</strong>
          <span>Reported range of motion</span>
        </div>

        <div>
          <strong>Biomimetic</strong>
          <span>Joint architecture</span>
        </div>

        <div>
          <strong>Prototype</strong>
          <span>Designed and assembled</span>
        </div>

      </div>

    </div>


    <figure class="portfolio-main-visual">

      <img
        src="/images/projects/human-arm/human-arm-main.jpg"
        alt="Human Arm biomimetic robotic arm prototype"
      />

      <figcaption>
        Final prototype | Lightweight articulated robotic arm
      </figcaption>

    </figure>

  </section>


  <!-- 01 | MOTIVATION -->

  <section class="detail-section">

    <div class="detail-index">
      01
    </div>

    <div class="detail-copy">

      <h2>
        Motivation
      </h2>

      <p>
        Conventional robotic arms often achieve precision through rigid joints
        and increasingly sophisticated control.
      </p>

      <p>
        Human Arm explored the opposite question:
        how much useful behaviour can be created directly through the mechanical
        architecture of the arm?
      </p>

      <p>
        The objective was to investigate lightweight joints and a mechanical
        arrangement capable of providing a large range of motion while remaining
        suitable for rapid prototyping.
      </p>

    </div>

  </section>


  <!-- DESIGN PROCESS -->

  <section class="portfolio-visual-section">

    <div class="portfolio-section-header">

      <span>
        02 | Design process
      </span>

      <h2>
        From anatomy to mechanism.
      </h2>

    </div>


    <div class="process-grid">

      <figure>

        <img
          src="/images/projects/human-arm/human-arm-sketch.jpg"
          alt="Initial sketches for the Human Arm robotic mechanism"
        />

        <figcaption>
          01 | Initial sketches and kinematic exploration
        </figcaption>

      </figure>


      <figure>

        <img
          src="/images/projects/human-arm/human-arm-cad.jpg"
          alt="CAD model of the Human Arm robotic joint architecture"
        />

        <figcaption>
          02 | CAD development and joint integration
        </figcaption>

      </figure>


      <figure>

        <img
          src="/images/projects/human-arm/human-arm-prototype.jpg"
          alt="Physical prototype of the Human Arm project"
        />

        <figcaption>
          03 | Physical prototype and assembly
        </figcaption>

      </figure>

    </div>

  </section>


  <!-- 03 | MY CONTRIBUTION -->

  <section class="detail-section">

    <div class="detail-index">
      03
    </div>

    <div class="detail-copy">

      <h2>
        My contribution
      </h2>

      <p>
        My work focused on the mechanical architecture of the arm and its
        articulated joints.
      </p>

      <ul>
        <li>
          Designed the overall arm architecture
        </li>

        <li>
          Developed lightweight articulated joint concepts
        </li>

        <li>
          Explored human-inspired ranges of motion
        </li>

        <li>
          Iterated joint geometries through CAD
        </li>

        <li>
          Produced and assembled physical prototypes
        </li>

        <li>
          Evaluated motion limits and mechanical interference
        </li>
      </ul>

    </div>

  </section>


  <!-- SYSTEM / SUBSYSTEM -->

  <section class="portfolio-system">

    <div class="portfolio-section-header">

      <span>
        04 | Architecture
      </span>

      <h2>
        System first. Joint second.
      </h2>

    </div>


    <div class="system-grid">

      <figure class="system-overview">

        <img
          src="/images/projects/human-arm/human-arm-system.jpg"
          alt="Overall architecture of the Human Arm robotic system"
        />

        <figcaption>
          Overall robotic arm architecture
        </figcaption>

      </figure>


      <div class="subsystem-stack">

        <figure>

          <img
            src="/images/projects/human-arm/human-arm-joint.jpg"
            alt="Close-up of the Human Arm robotic joint"
          />

          <figcaption>
            Joint architecture | Geometry and articulation
          </figcaption>

        </figure>


        <div class="subsystem-copy">

          <h3>
            Joint design
          </h3>

          <p>
            The joint geometry was developed to maximise usable angular travel
            while limiting unnecessary mass and mechanical interference.
          </p>

          <p>
            Rather than treating each joint independently, the arm was designed
            as a complete kinematic chain where neighbouring joints influence the
            reachable workspace.
          </p>

        </div>

      </div>

    </div>

  </section>


  <!-- 05 | RANGE OF MOTION -->

  <section class="detail-section">

    <div class="detail-index">
      05
    </div>

    <div class="detail-copy">

      <h2>
        Range of motion
      </h2>

      <p>
        One of the principal design objectives was to extend the usable workspace
        of the robotic arm while maintaining a lightweight architecture.
      </p>

      <p>
        The resulting joint system produced a reported 75% increase in range of
        motion compared with the initial architecture.
      </p>

    </div>

  </section>


  <!-- PERFORMANCE VISUAL -->

  <section class="portfolio-wide-visual">

    <figure>

      <img
        src="/images/projects/human-arm/human-arm-motion.jpg"
        alt="Multiple positions showing the range of motion of the Human Arm"
      />

      <figcaption>
        Motion study | Multiple arm configurations illustrating the reachable workspace
      </figcaption>

    </figure>

  </section>


  <!-- 06 | ITERATION -->

  <section class="detail-section">

    <div class="detail-index">
      06
    </div>

    <div class="detail-copy">

      <h2>
        Iteration
      </h2>

      <p>
        The design evolved through repeated transitions between sketches,
        CAD models and physical prototypes.
      </p>

      <p>
        Each iteration was used to identify geometric interference, assembly
        constraints and limitations in the reachable workspace before modifying
        the next version.
      </p>

      <p>
        This process made the physical prototype an engineering tool rather than
        simply a final demonstrator.
      </p>

    </div>

  </section>


  <!-- DOCUMENTATION -->

  <section class="portfolio-documents">

    <div class="portfolio-section-header">

      <span>
        07 | Documentation
      </span>

      <h2>
        Engineering records.
      </h2>

    </div>


    <div class="document-grid">

      <a
        href="/documents/human-arm/design-report.pdf"
        target="_blank"
        class="document-card"
      >

        <div>

          <span class="document-type">
            PDF
          </span>

          <h3>
            Design report
          </h3>

          <p>
            Design choices, mechanical architecture and development process.
          </p>

        </div>

        <span class="document-arrow">
          ↗
        </span>

      </a>


      <a
        href="/documents/human-arm/test-report.pdf"
        target="_blank"
        class="document-card"
      >

        <div>

          <span class="document-type">
            PDF
          </span>

          <h3>
            Test report
          </h3>

          <p>
            Prototype observations, motion evaluation and design conclusions.
          </p>

        </div>

        <span class="document-arrow">
          ↗
        </span>

      </a>


      <a
        href="/documents/human-arm/drawings.pdf"
        target="_blank"
        class="document-card"
      >

        <div>

          <span class="document-type">
            PDF
          </span>

          <h3>
            Technical drawings
          </h3>

          <p>
            Selected manufacturing drawings and mechanical definitions.
          </p>

        </div>

        <span class="document-arrow">
          ↗
        </span>

      </a>

    </div>

  </section>


  <!-- 08 | SKILLS -->

  <section class="detail-section">

    <div class="detail-index">
      08
    </div>

    <div class="detail-copy">

      <h2>
        Engineering skills
      </h2>

      <ul>
        <li>
          Biomimetic mechanical design
        </li>

        <li>
          Kinematic architecture
        </li>

        <li>
          CAD modelling
        </li>

        <li>
          Joint design
        </li>

        <li>
          Lightweight design
        </li>

        <li>
          Rapid prototyping
        </li>

        <li>
          Mechanical assembly
        </li>

        <li>
          Design iteration
        </li>
      </ul>

    </div>

  </section>


  <!-- 09 | LEARNING -->

  <section class="detail-section">

    <div class="detail-index">
      09
    </div>

    <div class="detail-copy">

      <h2>
        What I learned
      </h2>

      <p>
        Human Arm reinforced my interest in embodied intelligence:
        the idea that useful behaviour can emerge from mechanical architecture,
        geometry and compliance before control software is considered.
      </p>

      <p>
        It also demonstrated the importance of physical prototyping for revealing
        limitations that are difficult to identify from CAD alone.
      </p>

    </div>

  </section>

</ProjectLayout>


<style>

  /* MIT-INSPIRED PORTFOLIO STRUCTURE */

  .portfolio-hero {
    display: grid;

    grid-template-columns:
      minmax(300px, 0.8fr)
      minmax(500px, 1.8fr);

    gap: 48px;

    align-items: center;

    padding: 40px 0 100px;
  }


  .portfolio-kicker {
    display: block;

    margin-bottom: 18px;

    font-size: 10px;
    font-weight: 650;

    letter-spacing: 0.12em;

    text-transform: uppercase;

    color: var(--text-secondary);
  }


  .portfolio-outcome h2,
  .portfolio-section-header h2 {
    margin: 0;

    font-size: clamp(38px, 5vw, 72px);

    line-height: 0.98;

    letter-spacing: -0.05em;
  }


  .portfolio-outcome > p {
    margin-top: 26px;

    max-width: 520px;

    font-size: 17px;
    line-height: 1.6;

    color: var(--text-secondary);
  }


  /* METRICS */

  .portfolio-metrics {
    display: grid;

    gap: 18px;

    margin-top: 40px;
  }


  .portfolio-metrics div {
    padding-top: 14px;

    border-top: 1px solid var(--border);
  }


  .portfolio-metrics strong {
    display: block;

    margin-bottom: 4px;

    font-size: 24px;

    color: var(--text);
  }


  .portfolio-metrics span {
    font-size: 12px;

    color: var(--text-secondary);
  }


  /* IMAGES */

  .portfolio-main-visual img,
  .process-grid img,
  .system-grid img,
  .portfolio-wide-visual img {
    width: 100%;

    display: block;

    object-fit: cover;

    background: #e8e8ea;
  }


  .portfolio-main-visual img {
    aspect-ratio: 4 / 3;
  }


  figure {
    margin: 0;
  }


  figcaption {
    margin-top: 10px;

    font-size: 11px;
    line-height: 1.4;

    color: var(--text-secondary);
  }


  /* VISUAL SECTIONS */

  .portfolio-visual-section,
  .portfolio-system,
  .portfolio-documents {
    padding: 100px 0;

    border-top: 1px solid var(--border);
  }


  .portfolio-section-header {
    display: grid;

    grid-template-columns: 1fr 3fr;

    gap: 40px;

    margin-bottom: 56px;
  }


  .portfolio-section-header > span {
    font-size: 12px;

    color: var(--text-secondary);
  }


  /* PROCESS */

  .process-grid {
    display: grid;

    grid-template-columns:
      repeat(3, 1fr);

    gap: 22px;
  }


  .process-grid img {
    aspect-ratio: 4 / 3;
  }


  /* SYSTEM */

  .system-grid {
    display: grid;

    grid-template-columns: 1.8fr 1fr;

    gap: 24px;
  }


  .system-overview img {
    aspect-ratio: 4 / 3;
  }


  .subsystem-stack {
    display: grid;

    gap: 28px;
  }


  .subsystem-stack img {
    aspect-ratio: 4 / 3;
  }


  .subsystem-copy h3 {
    margin-bottom: 14px;

    font-size: 24px;
  }


  .subsystem-copy p {
    font-size: 15px;
    line-height: 1.6;

    color: var(--text-secondary);
  }


  /* WIDE RESULT VISUAL */

  .portfolio-wide-visual {
    padding: 80px 0 100px;
  }


  .portfolio-wide-visual img {
    max-height: 720px;

    object-fit: cover;

    aspect-ratio: 16 / 8;
  }


  /* DOCUMENTS */

  .document-grid {
    display: grid;

    grid-template-columns:
      repeat(3, 1fr);

    gap: 16px;
  }


  .document-card {
    min-height: 220px;

    display: flex;

    justify-content: space-between;

    padding: 24px;

    border: 1px solid var(--border);

    color: var(--text);

    text-decoration: none;

    transition:
      border-color 0.2s ease,
      transform 0.2s ease,
      background 0.2s ease;
  }


  .document-card:hover {
    border-color: #d60000;

    background: rgba(214, 0, 0, 0.025);

    transform: translateY(-3px);
  }


  .document-type {
    display: block;

    margin-bottom: 34px;

    font-size: 9px;
    font-weight: 650;

    letter-spacing: 0.12em;

    color: #d60000;
  }


  .document-card h3 {
    margin-bottom: 10px;

    font-size: 20px;
  }


  .document-card p {
    max-width: 260px;

    font-size: 13px;
    line-height: 1.5;

    color: var(--text-secondary);
  }


  .document-arrow {
    align-self: flex-start;

    font-size: 16px;
  }


  /* RESPONSIVE */

  @media (max-width: 900px) {

    .portfolio-hero,
    .system-grid {
      grid-template-columns: 1fr;
    }


    .process-grid,
    .document-grid {
      grid-template-columns: 1fr;
    }


    .portfolio-section-header {
      grid-template-columns: 1fr;

      gap: 18px;
    }

  }

</style>