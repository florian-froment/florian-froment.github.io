---
import ProjectLayout from "../../../layouts/ProjectLayout.astro";
---

<ProjectLayout
  title="Robotic Machining Cell"
  category="Project | Robotic Manufacturing"
  year="2026"
  description="ICAM engineering project exploring a robotic machining cell combining 3D scanning, geometric reconstruction, spindle machining and automated deburring."
>

  <p slot="intro">
    A robotic manufacturing cell developed during the ICAM engineering curriculum,
    combining 3D scanning, geometric reconstruction, robotic milling and automated
    deburring within a single flexible manufacturing system.
  </p>


  <!-- PROJECT SNAPSHOT -->

  <section class="portfolio-hero">

    <div class="portfolio-outcome">

      <span class="portfolio-kicker">
        Outcome
      </span>

      <h2>
        Scan the real part. Reconstruct it. Machine what is actually there.
      </h2>

      <p>
        SCANMILL 3D explored a robotic manufacturing workflow in which the
        geometry of a real component is first captured, reconstructed digitally,
        and then used to generate adapted machining and deburring trajectories.
      </p>

      <div class="portfolio-metrics">

        <div>
          <strong>3D Scan</strong>
          <span>Real-part acquisition</span>
        </div>

        <div>
          <strong>Milling</strong>
          <span>Robotic spindle integration</span>
        </div>

        <div>
          <strong>Deburring</strong>
          <span>Automated finishing</span>
        </div>

      </div>

    </div>


    <figure class="portfolio-main-visual">

      <img
        src="/images/projects/robotic-machining-cell/cell-main.jpg"
        alt="SCANMILL 3D robotic machining cell"
      />

      <figcaption>
        SCANMILL 3D | Robotic scan, machining and deburring concept
      </figcaption>

    </figure>

  </section>


  <!-- 01 | CONTEXT -->

  <section class="detail-section">

    <div class="detail-index">
      01
    </div>

    <div class="detail-copy">

      <h2>
        Context
      </h2>

      <p>
        The project was developed as part of my engineering curriculum at ICAM.
      </p>

      <p>
        The objective was to study a flexible robotic manufacturing cell capable
        of adapting machining and finishing operations to the actual geometry
        of a manufactured component.
      </p>

      <p>
        Instead of assuming that every workpiece perfectly matches its nominal
        CAD model, the system uses 3D acquisition to account for the real part
        before generating the manufacturing operation.
      </p>

    </div>

  </section>


  <!-- 02 | SYSTEM CONCEPT -->

  <section class="portfolio-visual-section">

    <div class="portfolio-section-header">

      <span>
        02 | System concept
      </span>

      <h2>
        Scan. Reconstruct. Machine. Finish.
      </h2>

    </div>


    <div class="process-grid">

      <figure>

        <img
          src="/images/projects/robotic-machining-cell/scan.jpg"
          alt="3D scanning stage of SCANMILL 3D"
        />

        <figcaption>
          01 | Acquire the real geometry
        </figcaption>

      </figure>


      <figure>

        <img
          src="/images/projects/robotic-machining-cell/reconstruction.jpg"
          alt="3D reconstruction of a scanned component"
        />

        <figcaption>
          02 | Reconstruct the digital geometry
        </figcaption>

      </figure>


      <figure>

        <img
          src="/images/projects/robotic-machining-cell/machining.jpg"
          alt="Robot machining the reconstructed component"
        />

        <figcaption>
          03 | Generate and execute the operation
        </figcaption>

      </figure>

    </div>

  </section>


  <!-- 03 | OBJECTIVES -->

  <section class="detail-section">

    <div class="detail-index">
      03
    </div>

    <div class="detail-copy">

      <h2>
        Engineering objectives
      </h2>

      <ul>
        <li>
          Integrate a machining spindle on an industrial robot
        </li>

        <li>
          Integrate an automated deburring tool
        </li>

        <li>
          Acquire the geometry of a real component in 3D
        </li>

        <li>
          Reconstruct usable digital geometry from scan data
        </li>

        <li>
          Generate machining trajectories from the reconstructed part
        </li>

        <li>
          Adapt operations to geometric deviations
        </li>

        <li>
          Create a flexible manufacturing workflow
        </li>
      </ul>

    </div>

  </section>


