---
import ProjectLayout from "../../../layouts/ProjectLayout.astro";
---

<ProjectLayout
  title="Automatic Washing Tank"
  category="Project | Industrial Process Engineering"
  year="2023"
  description="Design and industrialisation of an automatic washing tank for aerospace components, developed during a methods engineering internship at RTX | Collins Aerospace | Ratier-Figeac."
>

  <p slot="intro">
    An industrial washing system developed to improve aerospace part preparation,
    support REACH compliance and increase process repeatability through a more
    controlled and automated cleaning sequence.
  </p>


  <!-- PROJECT SNAPSHOT -->

  <section class="portfolio-hero">

    <div class="portfolio-outcome">

      <span class="portfolio-kicker">
        Outcome
      </span>

      <h2>
        Turning a cleaning operation into a controlled industrial process.
      </h2>

      <p>
        The project focused on redesigning and formalising an industrial washing
        process used for aerospace components, with the objective of improving
        repeatability, reducing preparation time and eliminating regulatory risk
        associated with non-compliant cleaning practices.
      </p>

      <div class="portfolio-metrics">

        <div>
          <strong>-18%</strong>
          <span>Part preparation time</span>
        </div>

        <div>
          <strong>REACH</strong>
          <span>Compliant process</span>
        </div>

        <div>
          <strong>30+</strong>
          <span>Technical and process documents</span>
        </div>

      </div>

    </div>


    <figure class="portfolio-main-visual">

      <img
        src="/images/projects/automatic-washing-tank/washing-tank-main.jpg"
        alt="Automatic washing tank developed for aerospace component cleaning"
      />

      <figcaption>
        Final concept | Automated aerospace component washing system
      </figcaption>

    </figure>

  </section>


  <!-- 01 | PROBLEM -->

  <section class="detail-section">

    <div class="detail-index">
      01
    </div>

    <div class="detail-copy">

      <h2>
        Industrial problem
      </h2>

      <p>
        Aerospace component preparation requires repeatable cleaning conditions
        before subsequent manufacturing, inspection or treatment operations.
      </p>

      <p>
        The existing process had to be reconsidered in order to reduce regulatory
        risk, improve cleaning consistency and limit unnecessary preparation time.
      </p>

      <p>
        The project therefore combined process engineering, industrial equipment
        definition and quality control.
      </p>

    </div>

  </section>


  <!-- 02 | REQUIREMENTS -->

  <section class="portfolio-visual-section">

    <div class="portfolio-section-header">

      <span>
        02 | Requirements
      </span>

      <h2>
        From constraints to specifications.
      </h2>

    </div>


    <div class="process-grid">

      <figure>

        <img
          src="/images/projects/automatic-washing-tank/process-sketch.jpg"
          alt="Initial industrial washing process sketch"
        />

        <figcaption>
          01 | Existing process analysis
        </figcaption>

      </figure>


      <figure>

        <img
          src="/images/projects/automatic-washing-tank/requirements.jpg"
          alt="Automatic washing tank engineering requirements"
        />

        <figcaption>
          02 | Functional and regulatory requirements
        </figcaption>

      </figure>


      <figure>

        <img
          src="/images/projects/automatic-washing-tank/concept.jpg"
          alt="Automatic washing tank concept development"
        />

        <figcaption>
          03 | Concept development
        </figcaption>

      </figure>

    </div>

  </section>


  <!-- 03 | MY CONTRIBUTION -->

  <section class="detail-section">

    <div class="detail-index">
      03
    </div>

    <div class="detail-copy">

      <h2>
        My contribution
      </h2>

      <ul>
        <li>
          Analysed the existing industrial washing process
        </li>

        <li>
          Contributed to defining a REACH-compliant cleaning solution
        </li>

        <li>
          Structured the washing and preparation sequence
        </li>

        <li>
          Produced technical and manufacturing documentation
        </li>

        <li>
          Developed quality control procedures
        </li>

        <li>
          Created decision-making logic for process validation
        </li>

        <li>
          Supported industrial implementation and process standardisation
        </li>
      </ul>

    </div>

  </section>


  <!-- 04 | SYSTEM ARCHITECTURE -->

  <section class="portfolio-system">

    <div class="portfolio-section-header">

      <span>
        04 | System architecture
      </span>

      <h2>
        Cleaning as an engineered system.
      </h2>

    </div>


    <div class="system-grid">

      <figure class="system-overview">

        <img
          src="/images/projects/automatic-washing-tank/system-overview.jpg"
          alt="Overall architecture of the automatic washing tank"
        />

        <figcaption>
          Overall washing system architecture
        </figcaption>

      </figure>


      <div class="subsystem-stack">

        <figure>

          <img
            src="/images/projects/automatic-washing-tank/tank-detail.jpg"
            alt="Detail of the washing tank and fluid circuit"
          />

          <figcaption>
            Tank and process-fluid subsystem
          </figcaption>

        </figure>


        <div class="subsystem-copy">

          <h3>
            Process control
          </h3>

          <p>
            The washing sequence was treated as a controlled industrial process,
            with defined preparation steps, cleaning conditions and acceptance criteria.
          </p>

          <p>
            This approach made it possible to connect equipment design directly
            with quality requirements and process documentation.
          </p>

        </div>

      </div>

    </div>

  </section>


  <!-- 05 | REACH -->

  <section class="detail-section">

    <div class="detail-index">
      05
    </div>

    <div class="detail-copy">

      <h2>
        REACH compliance
      </h2>

      <p>
        One of the main objectives of the project was to establish an industrial
        washing process compatible with REACH requirements.
      </p>

      <p>
        The project therefore required reconsidering cleaning products, process
        steps and operational documentation while maintaining the expected
        cleaning performance for aerospace components.
      </p>

    </div>

  </section>


  <!-- 06 | PROCESS OPTIMISATION -->

  <section class="detail-section">

    <div class="detail-index">
      06
    </div>

    <div class="detail-copy">

      <h2>
        Process optimisation
      </h2>

      <p>
        The revised cleaning sequence reduced the reported preparation time
        of parts by 18%.
      </p>

      <p>
        The process was also designed to reduce failures during cleaning steps,
        improving repeatability and limiting unnecessary rework.
      </p>

    </div>

  </section>


  <!-- RESULT VISUAL -->

  <section class="portfolio-wide-visual">

    <figure>

      <img
        src="/images/projects/automatic-washing-tank/process-flow.jpg"
        alt="Automatic washing process flow from preparation to quality validation"
      />

      <figcaption>
        Process flow | Preparation, cleaning, verification and validation
      </figcaption>

    </figure>

  </section>


  <!-- 07 | QUALITY -->

  <section class="detail-section">

    <div class="detail-index">
      07
    </div>

    <div class="detail-copy">

      <h2>
        Quality control
      </h2>

      <p>
        Quality procedures were developed to define how cleaning results should
        be evaluated and what action should be taken when a part did not meet
        the expected criteria.
      </p>

      <p>
        This transformed the washing operation from an operator-dependent task
        into a more structured and traceable industrial process.
      </p>

    </div>

  </section>


  <!-- DOCUMENTATION -->

  <section class="portfolio-documents">

    <div class="portfolio-section-header">

      <span>
        08 | Documentation
      </span>

      <h2>
        Engineering records.
      </h2>

    </div>


    <div class="document-grid">

      <a
        href="/documents/automatic-washing-tank/process-report.pdf"
        target="_blank"
        class="document-card"
      >

        <div>

          <span class="document-type">
            PDF
          </span>

          <h3>
            Process report
          </h3>

          <p>
            Analysis of the washing process, requirements and implementation.
          </p>

        </div>

        <span class="document-arrow">
          ↗
        </span>

      </a>


      <a
        href="/documents/automatic-washing-tank/quality-procedure.pdf"
        target="_blank"
        class="document-card"
      >

        <div>

          <span class="document-type">
            PDF
          </span>

          <h3>
            Quality procedure
          </h3>

          <p>
            Inspection criteria and decision-making process for cleaning validation.
          </p>

        </div>

        <span class="document-arrow">
          ↗
        </span>

      </a>


      <a
        href="/documents/automatic-washing-tank/technical-drawings.pdf"
        target="_blank"
        class="document-card"
      >

        <div>

          <span class="document-type">
            PDF
          </span>

          <h3>
            Technical drawings
          </h3>

          <p>
            Selected mechanical definitions and industrial equipment drawings.
          </p>

        </div>

        <span class="document-arrow">
          ↗
        </span>

      </a>

    </div>

  </section>


  <!-- 09 | SKILLS -->

  <section class="detail-section">

    <div class="detail-index">
      09
    </div>

    <div class="detail-copy">

      <h2>
        Engineering skills
      </h2>

      <ul>
        <li>
          Methods engineering
        </li>

        <li>
          Industrial process design
        </li>

        <li>
          REACH compliance
        </li>

        <li>
          Process optimisation
        </li>

        <li>
          Quality control
        </li>

        <li>
          Technical documentation
        </li>

        <li>
          Decision-making process design
        </li>

        <li>
          Industrialisation
        </li>
      </ul>

    </div>

  </section>


  <!-- 10 | LEARNING -->

  <section class="detail-section">

    <div class="detail-index">
      10
    </div>

    <div class="detail-copy">

      <h2>
        What I learned
      </h2>

      <p>
        This project taught me that an industrial process cannot be improved
        through equipment design alone.
      </p>

      <p>
        Regulatory requirements, operator actions, quality criteria,
        documentation and process repeatability must all be considered as part
        of the same engineering system.
      </p>

      <p>
        It was also one of my first experiences connecting mechanical engineering
        with methods engineering and formal industrial qualification.
      </p>

    </div>

  </section>

</ProjectLayout>


<style>

  .portfolio-hero {
    display: grid;

    grid-template-columns:
      minmax(300px, 0.8fr)
      minmax(500px, 1.8fr);

    gap: 48px;

    align-items: center;

    padding: 40px 0 100px;
  }


  .portfolio-kicker {
    display: block;

    margin-bottom: 18px;

    font-size: 10px;
    font-weight: 650;

    letter-spacing: 0.12em;

    text-transform: uppercase;

    color: var(--text-secondary);
  }


  .portfolio-outcome h2,
  .portfolio-section-header h2 {
    margin: 0;

    font-size: clamp(38px, 5vw, 72px);

    line-height: 0.98;

    letter-spacing: -0.05em;
  }


  .portfolio-outcome > p {
    margin-top: 26px;

    max-width: 520px;

    font-size: 17px;
    line-height: 1.6;

    color: var(--text-secondary);
  }


  .portfolio-metrics {
    display: grid;

    gap: 18px;

    margin-top: 40px;
  }


  .portfolio-metrics div {
    padding-top: 14px;

    border-top: 1px solid var(--border);
  }


  .portfolio-metrics strong {
    display: block;

    margin-bottom: 4px;

    font-size: 24px;

    color: var(--text);
  }


  .portfolio-metrics span {
    font-size: 12px;

    color: var(--text-secondary);
  }


  .portfolio-main-visual img,
  .process-grid img,
  .system-grid img,
  .portfolio-wide-visual img {
    width: 100%;

    display: block;

    object-fit: cover;

    background: #e8e8ea;
  }


  .portfolio-main-visual img {
    aspect-ratio: 4 / 3;
  }


  figure {
    margin: 0;
  }


  figcaption {
    margin-top: 10px;

    font-size: 11px;
    line-height: 1.4;

    color: var(--text-secondary);
  }


  .portfolio-visual-section,
  .portfolio-system,
  .portfolio-documents {
    padding: 100px 0;

    border-top: 1px solid var(--border);
  }


  .portfolio-section-header {
    display: grid;

    grid-template-columns: 1fr 3fr;

    gap: 40px;

    margin-bottom: 56px;
  }


  .portfolio-section-header > span {
    font-size: 12px;

    color: var(--text-secondary);
  }


  .process-grid {
    display: grid;

    grid-template-columns:
      repeat(3, 1fr);

    gap: 22px;
  }


  .process-grid img {
    aspect-ratio: 4 / 3;
  }


  .system-grid {
    display: grid;

    grid-template-columns: 1.8fr 1fr;

    gap: 24px;
  }


  .system-overview img {
    aspect-ratio: 4 / 3;
  }


  .subsystem-stack {
    display: grid;

    gap: 28px;
  }


  .subsystem-stack img {
    aspect-ratio: 4 / 3;
  }


  .subsystem-copy h3 {
    margin-bottom: 14px;

    font-size: 24px;
  }


  .subsystem-copy p {
    font-size: 15px;
    line-height: 1.6;

    color: var(--text-secondary);
  }


  .portfolio-wide-visual {
    padding: 80px 0 100px;
  }


  .portfolio-wide-visual img {
    max-height: 720px;

    object-fit: cover;

    aspect-ratio: 16 / 8;
  }


  .document-grid {
    display: grid;

    grid-template-columns:
      repeat(3, 1fr);

    gap: 16px;
  }


  .document-card {
    min-height: 220px;

    display: flex;

    justify-content: space-between;

    padding: 24px;

    border: 1px solid var(--border);

    color: var(--text);

    text-decoration: none;

    transition:
      border-color 0.2s ease,
      transform 0.2s ease,
      background 0.2s ease;
  }


  .document-card:hover {
    border-color: #d60000;

    background: rgba(214, 0, 0, 0.025);

    transform: translateY(-3px);
  }


  .document-type {
    display: block;

    margin-bottom: 34px;

    font-size: 9px;
    font-weight: 650;

    letter-spacing: 0.12em;

    color: #d60000;
  }


  .document-card h3 {
    margin-bottom: 10px;

    font-size: 20px;
  }


  .document-card p {
    max-width: 260px;

    font-size: 13px;
    line-height: 1.5;

    color: var(--text-secondary);
  }


  .document-arrow {
    align-self: flex-start;

    font-size: 16px;
  }


  @media (max-width: 900px) {

    .portfolio-hero,
    .system-grid {
      grid-template-columns: 1fr;
    }


    .process-grid,
    .document-grid {
      grid-template-columns: 1fr;
    }


    .portfolio-section-header {
      grid-template-columns: 1fr;

      gap: 18px;
    }

  }

</style>